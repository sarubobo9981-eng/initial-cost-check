# Claude APIキー（サーバー側のみで使用。フロントエンドには一切公開されません）
# 未設定の場合、見積書の自動解析機能は無効になり「解析機能が設定されていません」と表示されます。
ANTHROPIC_API_KEY=

# 任意：使用するモデル（未設定時は claude-sonnet-5 を使用）
ANTHROPIC_ESTIMATE_MODEL=

# Vercel Blob（見積書ファイルの一時アップロード先）の読み書きトークン。サーバー側のみで使用します。
# Vercelダッシュボードで Blob ストアを作成すると自動的に払い出されます。
# ローカル開発時は `vercel env pull` 等で取得するか、ダッシュボードから値をコピーしてください。
BLOB_READ_WRITE_TOKEN=
